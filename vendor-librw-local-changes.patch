+{
+	uint32 alphafunc = rw::GetRenderState(rw::ALPHATESTFUNC);
+	uint32 alpharef = rw::GetRenderState(rw::ALPHATESTREF);
+	uint32 gsalphatest = rw::GetRenderState(rw::GSALPHATEST);
