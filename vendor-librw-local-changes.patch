+// Tamano que puede ocupar el bloque de morph targets dentro del STRUCT: por
+// cada target, 24 bytes (esfera envolvente + hasVertices + hasNormals) y luego
+// 0, 12*nv o 24*nv bytes segun traiga vertices y/o normales. El lector decidia
+// si el STRUCT lleva los 12 bytes de surface properties solo por la version, y
+// el respaldo por tamano no podia funcionar: contaba los 24 bytes de cabecera y
+// se dejaba los arrays, asi que no casaba con ningun DFF real. Ejemplo medido:
+// `admiral` chassis_hi tiene 68416 bytes y el calculo daba 32368; la diferencia
+// son justo 24*1502 de los vertices/normales del morph target. Por eso los DFF
+// reescritos por `indicator_audit.py` (version 0xc02ffff, con props) se leian 12
+// bytes desplazados: UVs y triangulos basura, MESHFALLBACK y, mas tarde, heap
+// corrupto que reventaba en Clump::clone/Frame::updateObjects/syncDirty/malloc.
+// Probando las dos variantes contra esta familia de tamanos la decision es unica
+// en las 7045 geometrias servidas (1460 se leen por fin alineadas).
+static bool
+odMorphPayloadPlausible(uint64 rest, int32 numVertices, int32 numMorphTargets)
+{
+	uint64 min, step;
+	if(numVertices <= 0 || numMorphTargets <= 0)
+		return false;
+	min = 24*(uint64)numMorphTargets;
+	if(rest < min)
+		return false;
+	step = 12*(uint64)numVertices;
+	if(step == 0)
+		return rest == min;
+	return (rest - min) % step == 0 &&
+	       (rest - min)/step <= 2*(uint64)numMorphTargets;
+}
