+	                              "leaf", "tree", "dirt", "hedge", "jungle",
+	                              "fern", "vine", "path", "sand", "veg",
+	                              "foliage", "weed", "beach", "rock", "gravel" };
+	char low[32];
+	int32 i, force = 0;
+	for(i = 0; i < 31 && name[i]; i++){
+		char c = name[i];
+		low[i] = (c >= 'A' && c <= 'Z') ? (char)(c + 32) : c;
+	}
